# ============================================================
# ResumeAuto Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control
# ============================================================

# Gmail Account Configuration
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-specific-password
# Optional second sender account. Both values must be set together.
GMAIL_ADDRESS_2=
GMAIL_APP_PASSWORD_2=

# Email Sending Configuration
EMAIL_SPEED=medium           # fast, medium, or slow
MAX_RETRIES=3                # Number of retry attempts for failed emails
RETRY_DELAY=5000             # Delay between retries in milliseconds
DAILY_LIMIT=450              # Maximum emails per account per day

# Resume/Attachment Configuration
ATTACHMENT_PATH=./resume.pdf # Path to your resume file
ATTACHMENT_ENABLED=true      # Whether to attach resume to emails

# Dashboard Configuration
DASHBOARD_PORT=3000          # Port for web dashboard

# Sending Behavior
HUMAN_JITTER=true           # Add random delays to appear more human-like
SOUND_ALERTS=true           # Play sound alerts
AUTO_PAUSE_FAILURES=3       # Auto-pause after N consecutive failures
RESEND_SENT_EMAILS=false    # Whether to resend to already-sent addresses
BUSINESS_HOURS_ONLY=false   # Only send during business hours
BUSINESS_START_HOUR=9       # Start of business hours (24-hour format)
BUSINESS_END_HOUR=18        # End of business hours (24-hour format)
SKIP_WEEKENDS=true          # Skip sending on weekends

# Webhook Configuration (optional)
WEBHOOK_ALERTS=false        # Enable webhook notifications
WEBHOOK_URL=                 # Your webhook URL for notifications

# Node Environment
NODE_ENV=development        # development or production

# AI Personalization (Google Gemini API - optional)
GEMINI_API_KEY=              # Get free key from aistudio.google.com

# Telegram Instant Alerts (optional)
TELEGRAM_BOT_TOKEN=          # Your Telegram Bot Token from @BotFather
TELEGRAM_CHAT_ID=            # Your Telegram Chat ID from @userinfobot

# Tracking Configuration (Open Beacon & Resume Click)
TRACKING_BASE_URL=http://localhost:3000 # Public URL or tunnel (e.g. ngrok) for tracking

# Automated Follow-up Drip Sequences
AUTO_DRIP_FOLLOWUP=false     # Automatically send Day 4 and Day 8 follow-ups
DRIP_DAY_1=4                 # Days until first follow-up bump
DRIP_DAY_2=8                 # Days until final closing follow-up

# IMAP Auto-Listener
AUTO_IMAP_POLL=true          # Auto-poll Gmail inbox in background for recruiter replies
