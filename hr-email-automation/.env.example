# ============================================================
# HR Email Automation System — Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# ---- SMTP Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=Milin Chaware

# ---- Candidate Information ----
CANDIDATE_NAME=Milin Chaware
JOB_ROLE=Senior Python Backend Developer
EXPERIENCE=4+ years
CURRENT_COMPANY=
SKILLS=Python, Django, FastAPI, PostgreSQL, REST APIs, Docker, AWS
PHONE=+91 7620369988
CANDIDATE_EMAIL=milinchaware9@gmail.com
LINKEDIN=https://www.linkedin.com/in/milin-chaware-9a1b4b1a7/

# ---- Resume Attachment ----
RESUME_PATH=./attachments/resume.pdf
RESUME_ENABLED=true
# Allowed extensions (comma-separated)
RESUME_ALLOWED_EXTENSIONS=.pdf,.doc,.docx
# Max file size in MB
RESUME_MAX_SIZE_MB=10

# ---- Rate Limiting ----
# Delay between emails in seconds
EMAIL_DELAY_SECONDS=10
# Maximum emails per single run
MAX_EMAILS_PER_RUN=50

# ---- Behavior ----
# Set to true to simulate sending without actually sending
DRY_RUN=false
# Set to true to skip the confirmation prompt
AUTO_CONFIRM=false

# ---- Database ----
# Path to SQLite database file (relative to project root)
DATABASE_PATH=./data/database/hr_automation.db

# ---- Blocked Email Domains ----
# Comma-separated list of personal email domains to reject
# You can add more domains as needed
BLOCKED_DOMAINS=gmail.com,yahoo.com,hotmail.com,outlook.com,live.com,icloud.com,protonmail.com,rediffmail.com,aol.com,zoho.com,yandex.com,mail.com,gmx.com,tutanota.com,fastmail.com,hushmail.com,inbox.com,proton.me

# ---- Logging ----
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=./logs/hr_automation.log
